# Plemmo EPOS Environment Configuration
# Copy this file to .env and customize as needed.
# No production secrets belong in this file or in the repository.

# JWT secret for authentication tokens.
# If not set, Plemmo EPOS generates a random secret on first launch.
# JWT_SECRET=your-secure-random-string-here

# API server port (default: 3001)
# PORT=3001

# KDS server port (default: 3002)
# KDS_PORT=3002

# Node environment: development, production, test (default: development)
# NODE_ENV=development

# Google Drive integration for automated DB backups (#129).
# Both must be set for the "Google Drive" section under Settings >
# Integrations to be usable — if either is missing, the UI shows
# "Google Drive integration is not configured for this build" instead of a
# broken Connect button. See docs/google-drive-setup.md for how to create
# these in Google Cloud Console (APIs & Services > Credentials).
# GOOGLE_DRIVE_CLIENT_ID=your-client-id.apps.googleusercontent.com
# GOOGLE_DRIVE_CLIENT_SECRET=your-client-secret

# ── Plemmo Cloud (desktop client) ───────────────────────────────────────────
# The Plemmo production cloud base URL this build talks to. There is NO default
# and a production build must NEVER point at FloPOS infrastructure. Leave unset
# for an offline-only build; merchants can also set it per-install in Settings.
# Must be HTTPS in production.
# PLEMMO_CLOUD_SERVER_URL=https://cloud.your-plemmo-domain.example

# Telemetry endpoint. Empty = telemetry is a hard no-op (nothing is ever sent).
# Set this only when Plemmo has its own telemetry collector. Never FloPOS.
# PLEMMO_TELEMETRY_URL=https://telemetry.your-plemmo-domain.example/collect

# ── Licensing (Ed25519) ─────────────────────────────────────────────────────
# Public key (SPKI PEM) pinned into the packaged build; when set, the client
# rejects unsigned/tampered license payloads. Single-line \n newlines accepted.
# PLEMMO_LICENSE_PUBLIC_KEY=

# ── Digital receipt email (desktop client) ──────────────────────────────────
# Set PLEMMO_EMAIL_TRANSPORT=http to enable emailed receipts via a webhook;
# unset / "none" records the request only (no send).
# PLEMMO_EMAIL_TRANSPORT=http
# PLEMMO_EMAIL_WEBHOOK_URL=https://your-email-relay.example/send
# PLEMMO_EMAIL_WEBHOOK_TOKEN=optional-bearer-token
# PLEMMO_EMAIL_FROM=receipts@your-plemmo-domain.example
